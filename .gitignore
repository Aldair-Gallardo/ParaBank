# ── Compilación de Maven (se recrea sola) ──
target/

# ── IntelliJ IDEA ──
.idea/
*.iml
*.iws
*.ipr
out/

# ── Eclipse / VS Code ──
.classpath
.project
.settings/
.vscode/

# ── Configuración personal y credenciales ──
config.local.properties

# ── Reportes generados ──
